---
// A screenshot of the pedalboard with its caption
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure>
	<Image src={src} alt={alt} widths={[768, 1280]} sizes="(max-width: 800px) 100vw, 736px" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
