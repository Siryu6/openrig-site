---
// Starlight's footer with the privacy line of the landing page
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default><slot /></Default>
<p class="privacy">
	Cookieless analytics with self-hosted Umami: no cookies, no personal data, Do Not Track respected.{' '}
	<a href={`${base}/privacy/`}>Privacy</a>
</p>

<style>
	.privacy {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.privacy a {
		color: inherit;
	}
</style>
