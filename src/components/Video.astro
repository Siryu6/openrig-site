---
// A screen recording from public/media: muted, looping, plays inline
interface Props {
	name: string;
	label: string;
	autoplay?: boolean;
}
const { name, label, autoplay = true } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/${name}`;
---

<video
	autoplay={autoplay}
	controls={!autoplay}
	muted
	loop
	playsinline
	preload="metadata"
	poster={`${src}.jpg`}
	width="1280"
	height="750"
	aria-label={label}
>
	<source src={`${src}.webm`} type="video/webm" />
	<source src={`${src}.mp4`} type="video/mp4" />
</video>
