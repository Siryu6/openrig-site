---
// A screen recording with its caption, in the docs
import Video from './Video.astro';

interface Props {
	name: string;
	label: string;
	caption?: string;
}
const { name, label, caption } = Astro.props;
---

<figure data-clip={name}>
	<Video name={name} label={label} autoplay={false} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	// Count the first play of each recording on a page
	for (const figure of document.querySelectorAll<HTMLElement>('figure[data-clip]')) {
		figure.querySelector('video')?.addEventListener(
			'play',
			() => window.umami?.track('video-play', { name: figure.dataset.clip, page: location.pathname }),
			{ once: true },
		);
	}
</script>
