---
import { Image } from 'astro:assets';
import SiteLayout from '../components/SiteLayout.astro';
import Video from '../components/Video.astro';
import { latestVersion } from '../release.mjs';

import strip from '../assets/shots/strip.png';
import editorAmp from '../assets/shots/editor-amp.png';
import tuner from '../assets/shots/tuner.png';
import looper from '../assets/shots/looper.png';
import monitor from '../assets/shots/monitor.png';
import addEffect from '../assets/shots/add-effect.png';
import setlists from '../assets/shots/setlists.png';

const version = await latestVersion();
const minor = version.split('.').slice(0, 2).join('.');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path = '') => `${base}/docs/${path}`;
---

<SiteLayout
	title="OpenRig — open source guitar pedalboard"
	description="OpenRig turns a Raspberry Pi 5 and a touchscreen into a guitar multi-effects pedalboard: neural amp captures, impulse responses, LV2 effects, scenes, setlists and MIDI. Free software, GPL-3.0."
>
	<section class="hero">
		<div class="wrap">
			<div class="hero-text">
				<span class="eyebrow"><span class="dot"></span> Version {minor} · Raspberry Pi 5 and x86_64</span>
				<h1>The open source pedalboard <em>you build yourself</em></h1>
				<p class="lede">
					OpenRig turns a Raspberry Pi 5, a USB audio interface and a touchscreen into a guitar
					multi-effects unit. Neural amp captures, impulse responses and LV2 effects, on a system
					that boots straight to the rack.
				</p>
				<div class="ctas">
					<a class="btn btn-primary" href={docs()} data-umami-event="get-started" data-umami-event-location="hero">Get started</a>
					<a class="btn btn-ghost" href="https://github.com/Siryu6/OpenRig/releases" data-umami-event="download" data-umami-event-location="hero" data-umami-event-version={minor}>Download {minor}</a>
				</div>
				<p class="hero-meta">Free software under the GPL-3.0 · No account needed</p>
			</div>
			<div class="screen">
				<Video name="hero" label="Selecting a block, turning a knob, bypassing a reverb and opening the editor" />
			</div>
			<p class="caption">
				Recorded from the x86_64 image at 1024×600. Peavey 5150 capture by @doubleyoud on TONE3000.
			</p>
		</div>
	</section>

	<div class="facts">
		<div class="wrap">
			<ul>
				<li><b>~5 ms</b><span>buffer each way: 128 frames × 2 at 48 kHz on a Pi 5</span></li>
				<li><b>0</b><span>allocations or blocking locks in the audio callback</span></li>
				<li><b>8 scenes</b><span>per preset, recalled without rebuilding the chain</span></li>
				<li><b>A/B</b><span>signed system updates that roll back on failure</span></li>
			</ul>
		</div>
	</div>

	<section id="features">
		<div class="wrap">
			<div class="section-head">
				<span class="kicker">Playing</span>
				<h2>Made to be played, not configured</h2>
				<p>
					Everything happens on the touchscreen: the signal chain is the main screen, every block is
					one tap away from its knobs, and nothing needs a computer once the card is written.
				</p>
			</div>

			<div class="feature">
				<div class="feature-text">
					<h3>The whole signal chain on one screen</h3>
					<p>
						Blocks are drawn after the gear they model: amp heads, combos, cabinets, pedals. Tap a
						block and its controls appear as knobs under the rack.
					</p>
					<ul class="ticks">
						<li>Tap for the knobs, double tap for the full editor, hold to bypass</li>
						<li>Hold and drag to move a block, including into a split</li>
						<li>A/B, Mix and left/right splits, nested as deep as you need</li>
						<li>Mono or stereo; input and output meters with clip LEDs</li>
					</ul>
					<a class="more" href={docs('using/rack/')} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="using/rack">The rack in the docs →</a>
				</div>
				<div class="screen small">
					<Image src={strip} alt="The rack with an amp block selected and its knobs along the bottom" widths={[720, 1280]} sizes="(max-width: 900px) 100vw, 680px" />
				</div>
			</div>

			<div class="feature flip">
				<div class="feature-text">
					<h3>Neural amps, pedals and cabinets</h3>
					<p>
						Amp, Amp + Cab and Pedal blocks run Neural Amp Modeler captures. Cabinet and Space blocks
						load impulse responses. They sit in the chain like any other block, next to LV2 plugins.
					</p>
					<ul class="ticks">
						<li>NAM <code>.nam</code> captures, plus RTNeural <code>.json</code> and <code>.aidax</code></li>
						<li>Noise gate, bass / middle / treble and input / output trims on every amp</li>
						<li>Light quality for A2 captures, about a quarter of the CPU</li>
						<li>Zero-latency impulse responses with level, mix and low / high cut</li>
					</ul>
					<a class="more" href={docs('using/neural-blocks/')} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="using/neural-blocks">Amps, pedals and cabinets →</a>
				</div>
				<div class="screen small">
					<Image src={editorAmp} alt="The block editor of an Amp block with its knobs and the tone preset list" widths={[720, 1280]} sizes="(max-width: 900px) 100vw, 680px" />
				</div>
			</div>

			<div class="feature">
				<div class="feature-text">
					<h3>TONE3000, on the pedalboard</h3>
					<p>
						Link your TONE3000 account once, then browse your favorites, your own tones and the
						trending ones right from a block. A capture downloads and loads in a couple of taps.
					</p>
					<ul class="ticks">
						<li>Linked with a QR code, approved on your phone</li>
						<li>Each block only lists the gear it can play</li>
						<li>Creator, license and source kept with every download</li>
						<li>Downloaded one at a time, when you ask for it</li>
					</ul>
					<span class="powered">Powered by <b>TONE3000</b></span>
					<br />
					<a class="more" href={docs('using/tone3000/')} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="using/tone3000">TONE3000 in the docs →</a>
				</div>
				<div>
					<div class="screen small">
						<Video name="tone3000" label="Browsing the TONE3000 trending tones from an Amp block and loading a Marshall JCM800 capture" />
					</div>
					<p class="caption">Marshall JCM800 2203x by @pamukparty on TONE3000.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap">
			<div class="feature flip">
				<div class="feature-text">
					<span class="kicker">On stage</span>
					<h3>A Live page for your feet</h3>
					<p>
						Eight switch tiles in Stomp, Scenes or Setlist mode, the tempo with a TAP button, and
						footswitches on the GPIO or any MIDI controller.
					</p>
					<ul class="ticks">
						<li>8 scenes per preset: bypass, knobs and splits in one switch</li>
						<li>Setlists keep every preset loaded, ready to switch</li>
						<li>Delay and reverb tails ring on across bypass and scene changes</li>
						<li>Tap tempo sent to plugins; hold the last switch for the tuner</li>
					</ul>
					<a class="more" href={docs('using/live/')} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="using/live">The Live page →</a>
				</div>
				<div class="screen small">
					<Video name="live" label="Toggling stomp switches, changing scenes and tapping the tempo on the Live page" />
				</div>
			</div>

			<div class="grid three" style="margin-top: 96px">
				<div class="card shot">
					<Image src={tuner} alt="The tuner showing A2 in tune" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 380px" />
					<div class="body">
						<h3>Tuner</h3>
						<p>Down to 38 Hz for drop tunings, 7 and 8 strings and bass, with optional mute.</p>
					</div>
				</div>
				<div class="card shot">
					<Image src={looper} alt="The looper playing a loop" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 380px" />
					<div class="body">
						<h3>Looper</h3>
						<p>Record, overdub in layers, undo. Stereo, after the effects, up to 30 seconds.</p>
					</div>
				</div>
				<div class="card shot">
					<Image src={setlists} alt="The setlist editor with five presets" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 380px" />
					<div class="body">
						<h3>Presets and setlists</h3>
						<p>Presets keep the whole chain, its scenes and tempo. Setlists map them to switches.</p>
					</div>
				</div>
			</div>

			<div class="grid two" style="margin-top: 18px">
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><circle cx="8" cy="10" r="1"></circle><circle cx="12" cy="8" r="1"></circle><circle cx="16" cy="10" r="1"></circle><circle cx="9" cy="14.5" r="1"></circle><circle cx="15" cy="14.5" r="1"></circle></svg>
					</div>
					<h3>MIDI, Helix-style</h3>
					<p>
						Program changes and banks for presets, CCs for scenes, footswitches, looper, tuner and tap.
						MIDI clock sets the tempo. Learn any knob to an expression pedal, with a heel / toe range.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"></path></svg>
					</div>
					<h3>Any LV2 plugin</h3>
					<p>
						Collections such as ZAM, x42, Calf, LSP, CAPS and the Guitarix GxPlugins: controls, ranges
						and units come from the plugin, and plugins that take tempo or MIDI get it.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="under-the-hood">
		<div class="wrap">
			<div class="section-head">
				<span class="kicker">Under the hood</span>
				<h2>Built like an appliance</h2>
				<p>
					OpenRig is not an app on a desktop. It ships as its own operating system, and the audio path
					is written so that nothing on the screen can make it drop out.
				</p>
			</div>

			<div class="grid three">
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h3l3-8 4 16 3-8h7"></path></svg>
					</div>
					<h3>Real-time safe audio</h3>
					<p>
						New chains are built on another thread and crossfaded in over 20 ms. Knobs, bypass and
						scenes change the running chain without a rebuild. The JACK callback never allocates.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
					</div>
					<h3>Read-only system</h3>
					<p>
						A Buildroot image with a <code>PREEMPT_RT</code> kernel boots straight into the UI, full
						screen, without X11 or Wayland. Your data lives on its own partition.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 3v6h-6"></path></svg>
					</div>
					<h3>Updates that can't brick it</h3>
					<p>
						Signed RAUC bundles install next to the running system. If the new one does not start,
						the pedalboard boots the previous one again. Presets and models are kept.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
					</div>
					<h3>Session always saved</h3>
					<p>
						The chain is saved a few seconds after each change and restored at startup. Pulling the
						power cable at the end of the gig is fine.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"></path><path d="M7 15l4-4 3 3 5-6"></path></svg>
					</div>
					<h3>Load you can see</h3>
					<p>
						The top bar shows the DSP load and temperature. Its details give peaks, dropouts, latency
						and Pi throttling, and the editor shows what each block costs.
					</p>
				</div>
				<div class="card">
					<div class="icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3v12"></path><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
					</div>
					<h3>Released with care</h3>
					<p>
						Every pull request runs formatting, Clippy and the tests. Versions follow semver from
						conventional commits; each release ships images, app bundles and changelog.
					</p>
				</div>
			</div>

			<div class="grid two" style="margin-top: 18px">
				<div class="card shot">
					<Image src={monitor} alt="The resource monitor with DSP load, CPU, memory and latency" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 580px" />
					<div class="body">
						<h3>Resource monitor</h3>
						<p>Shown here in QEMU. On a Pi 5 it adds the SoC temperature and under-voltage flags.</p>
					</div>
				</div>
				<div class="card shot">
					<Image src={addEffect} alt="Add effect: the Amp, Amp + Cab, Pedal, Cabinet and Space blocks, then the LV2 plugins by category" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 580px" />
					<div class="body">
						<h3>Built-in blocks and LV2</h3>
						<p>Neural and impulse response blocks work out of the box; LV2 plugins sit next to them.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="build" class="band">
		<div class="wrap">
			<div class="bom">
				<div>
					<span class="kicker">Build one</span>
					<h2 style="font-size: clamp(30px, 4vw, 44px)">Parts you can buy anywhere</h2>
					<p class="muted" style="margin-top: 18px; font-size: 18px">
						No custom board to order. Write the image to a card, plug in an audio interface and play.
						Footswitches are optional and wire straight to the GPIO.
					</p>
					<table class="spec" style="margin-top: 32px">
						<tbody>
							<tr><th>Computer</th><td>Raspberry Pi 5 (or Pi 500), or an x86_64 mini PC with UEFI and Intel graphics</td></tr>
							<tr><th>Audio</th><td>Any class-compliant USB audio interface</td></tr>
							<tr><th>Screen</th><td>A touchscreen; 1024×600 and up. A mouse works too</td></tr>
							<tr><th>Storage</th><td>A micro SD card of 8 GB or more: about 3 GB of system, the rest for your models</td></tr>
							<tr><th>Power</th><td>The official 27 W supply for a Pi 5 with USB devices</td></tr>
							<tr><th>Optional</th><td>Up to 8 footswitches and a rotary encoder on GPIO, MIDI controllers over USB</td></tr>
						</tbody>
					</table>
					<a class="more" href={docs('getting-started/hardware/')} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="getting-started/hardware">Full hardware guide →</a>
				</div>
				<div class="bom-diagram" aria-label="Wiring: the guitar goes into the USB audio interface, whose outputs go to an amp or PA; the interface, footswitches and a MIDI pedal connect to the Raspberry Pi, which drives the touchscreen">
					<svg viewBox="0 0 520 380" role="img" font-family="Inter Variable, system-ui, sans-serif">
						<defs>
							<marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#8e8e96"></path></marker>
						</defs>
						<g stroke="#8e8e96" stroke-width="1.5" fill="none">
							<path d="M260 150V98" marker-end="url(#arr)"></path>
							<path d="M135 190H183" marker-end="url(#arr)"></path>
							<path d="M385 190H337" marker-end="url(#arr)"></path>
							<path d="M260 286V234" marker-start="url(#arr)" marker-end="url(#arr)"></path>
							<path d="M135 326H183" marker-end="url(#arr)"></path>
							<path d="M337 326H385" marker-end="url(#arr)"></path>
						</g>
						<g fill="#8e8e96" font-size="11" text-anchor="middle">
							<text x="272" y="128" text-anchor="start">HDMI · USB</text>
							<text x="272" y="264" text-anchor="start">USB</text>
							<text x="159" y="182">GPIO</text>
							<text x="361" y="182">USB</text>
							<text x="159" y="318">jack</text>
							<text x="361" y="318">line</text>
						</g>
						<g fill="#111114" stroke="#2a2a30" stroke-width="1.5">
							<rect x="190" y="30" width="140" height="64" rx="10"></rect>
							<rect x="187" y="150" width="146" height="84" rx="12" stroke="#f0a43c"></rect>
							<rect x="15" y="158" width="120" height="64" rx="10"></rect>
							<rect x="385" y="158" width="120" height="64" rx="10"></rect>
							<rect x="187" y="290" width="146" height="72" rx="10"></rect>
							<rect x="15" y="294" width="120" height="64" rx="10"></rect>
							<rect x="385" y="294" width="120" height="64" rx="10"></rect>
						</g>
						<g fill="#ececef" font-size="14" font-weight="600" text-anchor="middle">
							<text x="260" y="60">Touchscreen</text>
							<text x="260" y="188">Raspberry Pi 5</text>
							<text x="75" y="188">Footswitches</text>
							<text x="445" y="188">MIDI pedal</text>
							<text x="260" y="324">USB interface</text>
							<text x="75" y="324">Guitar</text>
							<text x="445" y="324">Amp / PA</text>
						</g>
						<g fill="#6b6b74" font-size="11.5" text-anchor="middle">
							<text x="260" y="78">1024×600 and up</text>
							<text x="260" y="208">OpenRig OS</text>
							<text x="75" y="206">optional</text>
							<text x="445" y="206">optional</text>
							<text x="260" y="342">48 kHz, 128 × 2</text>
							<text x="75" y="342">into input 1</text>
							<text x="445" y="342">outputs 1 and 2</text>
						</g>
					</svg>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<div class="status">
				<span class="badge">v{minor}</span>
				<div>
					<h3>Where the project stands</h3>
					<p>
						OpenRig is young. It runs on a Raspberry Pi 5 (8 GB) with a Focusrite Scarlett 2i2 at 128 × 2,
						A/B updates and rollback included; the x86_64 image is tested in QEMU so far. Expect rough edges, and tell us about
						them: issues and pull requests are welcome.
					</p>
					<a class="more" href="https://github.com/Siryu6/OpenRig/issues" data-umami-event="github" data-umami-event-location="status" data-umami-event-target="issues">Report an issue →</a>
				</div>
			</div>
		</div>
	</section>

	<section class="closing band">
		<div class="wrap">
			<h2>Write a card, plug in, play</h2>
			<p>The image boots straight into the rack. The first start takes a minute longer while it sets up its data partition.</p>
			<div class="ctas">
				<a class="btn btn-primary" href={docs('getting-started/raspberry-pi/')} data-umami-event="docs-link" data-umami-event-location="closing" data-umami-event-target="getting-started/raspberry-pi">Install guide</a>
				<a class="btn btn-ghost" href={docs('dev/build/')} data-umami-event="docs-link" data-umami-event-location="closing" data-umami-event-target="dev/build">Build from source</a>
			</div>
			<div class="terminal"><span class="p">$ </span>xz -dc openrig-os-{version}-rpi5.img.xz | sudo dd of=/dev/sdX bs=4M conv=fsync</div>
		</div>
	</section>
</SiteLayout>
