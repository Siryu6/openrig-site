---
import SiteLayout from '../components/SiteLayout.astro';
---

<SiteLayout
	title="Privacy — OpenRig"
	description="Cookieless usage stats with self-hosted Umami: what is counted and how to opt out."
>
	<section>
		<div class="wrap privacy">
			<div class="section-head">
				<span class="kicker">Privacy</span>
				<h2>Usage stats, nothing personal</h2>
				<p>
					This site counts its visits with a self-hosted <a href="https://umami.is">Umami</a>. No cookies,
					no personal data, no ads, nothing shared with anyone. Just enough to know which pages are read.
				</p>
			</div>

			<h3>What is counted</h3>
			<ul class="ticks">
				<li>Pages viewed and the site you came from</li>
				<li>Browser, system, device type, screen size, language and country</li>
				<li>Page load times</li>
				<li>Clicks on the main buttons and links, video plays, code copies and search use</li>
			</ul>

			<h3>What is not</h3>
			<ul class="ticks">
				<li>No cookies, nothing stored on your device</li>
				<li>No IP addresses kept, no tracking across sites</li>
				<li>What you type in the search box is never sent</li>
			</ul>

			<h3>Opting out</h3>
			<p>
				Nothing is counted when your browser sends Do Not Track or Global Privacy Control. You can also
				turn it off for this site in this browser:
			</p>
			<p class="opt">
				<button class="btn btn-ghost" type="button" id="umami-opt" hidden></button>
				<span class="muted small" id="umami-state"></span>
			</p>
		</div>
	</section>
</SiteLayout>

<script>
	// Umami skips every send while localStorage has umami.disabled
	const button = document.querySelector<HTMLButtonElement>('#umami-opt')!;
	const state = document.querySelector<HTMLElement>('#umami-state')!;
	const render = () => {
		const off = localStorage.getItem('umami.disabled') !== null;
		button.textContent = off ? 'Turn measurement back on' : 'Turn measurement off';
		state.textContent = off ? 'Measurement is off in this browser.' : 'Measurement is on.';
		button.hidden = false;
	};
	button.addEventListener('click', () => {
		if (localStorage.getItem('umami.disabled') !== null) localStorage.removeItem('umami.disabled');
		else localStorage.setItem('umami.disabled', '1');
		render();
	});
	render();
</script>

<style>
	.privacy {
		max-width: 760px;
	}
	.privacy h3 {
		margin: 40px 0 14px;
	}
	.privacy p,
	.privacy li {
		color: var(--muted);
	}
	.privacy a {
		text-decoration: underline;
	}
	.opt {
		display: flex;
		gap: 16px;
		align-items: center;
		margin-top: 16px;
	}
</style>
